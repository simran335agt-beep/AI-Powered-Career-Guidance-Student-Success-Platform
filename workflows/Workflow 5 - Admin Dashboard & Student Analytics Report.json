      "parameters": {
        "jsCode": "const students = $input.all();\n\nconst totalStudents = students.length;\n\nconst aiStudents = students.filter(\n    s => s.json.Interests === \"AI\"\n).length;\n\nconst completed = students.filter(\n    s => s.json.Status === \"Completed\"\n).length;\n\nconst cgpaAbove8 = students.filter(\n    s => Number(s.json.CGPA) >= 8\n).length;\n\nreturn [{\n    json: {\n        totalStudents,\n        aiStudents,\n        completed,\n        cgpaAbove8,\n        generatedAt: new Date().toLocaleString()\n    }\n}];"
